# Healthspan Dashboard — local environment example
# Copy to .env / .env.local as needed. Never commit secrets.

# demo | live (default: live)
HEALTHSPAN_DATA_MODE=live

# Absolute override for application data directory (SQLite + raw/)
# Windows example:
# HEALTHSPAN_DATA_DIR=C:\Users\you\AppData\Local\Healthspan Dashboard
# Developer relative override requires:
# HEALTHSPAN_ALLOW_RELATIVE_DATA_DIR=1
# HEALTHSPAN_DATA_DIR=.local-data

# Optional NCBI / Crossref courtesy identifiers
# NCBI_TOOL=healthspan_dashboard
# NCBI_EMAIL=you@example.com
# NCBI_API_KEY=
# CROSSREF_MAILTO=you@example.com

# Caps for first-run / smoke ingestion
HEALTHSPAN_FIRST_RUN_RECORD_CAP=50
HEALTHSPAN_LIVE_SMOKE_RECORD_CAP=5

# Jobs / scheduler (local)
# HEALTHSPAN_JOB_WORKER_ENABLED=true
# HEALTHSPAN_SCHEDULER_ENABLED=true
# HEALTHSPAN_ALLOW_REMOTE_ADMIN=false

# Optional AI (disabled by default in M3)
# HEALTHSPAN_AI_ENABLED=false
# OPENAI_API_KEY=
