# Healthspan Dashboard — local environment example
# Copy to .env / .env.local as needed. Never commit secrets.

# local | sites (default: local)
HEALTHSPAN_RUNTIME=local

# demo | live (default: live)
HEALTHSPAN_DATA_MODE=live

# --- Hosted (Sites) runtime -------------------------------------------------
# Names only. Hosted values are set by the owner in Sites Settings and never here:
# the hosted runtime has no .env, and these variables have no effect locally.
# The hosted app fails closed when the owner email, session secret, or allowed
# origin is absent — it will serve nothing but /api/hosted-readiness.
# HEALTHSPAN_HOSTED_OWNER_EMAIL=
# HEALTHSPAN_HOSTED_SESSION_SECRET=
# Exactly one https origin. No wildcard, no path, no trailing slash.
# HEALTHSPAN_HOSTED_ALLOWED_ORIGIN=
# Comma-separated extra hosts for the owner-only saved-version preview host.
# HEALTHSPAN_HOSTED_PREVIEW_HOSTS=
# Only "manual" is supported — the hosted runtime has no persistent scheduler.
# HEALTHSPAN_HOSTED_SCHEDULER_MODE=manual
# The next three are prohibited in hosted and are rejected if set true.
# HEALTHSPAN_HOSTED_EXTERNAL_CONNECTORS=false
# HEALTHSPAN_HOSTED_PLATFORM_MONITORING=false
# HEALTHSPAN_HOSTED_AI_ENABLED=false
# Hosted data is synthetic only; this cannot be set false.
# HEALTHSPAN_HOSTED_FIXTURE_ONLY=true

# Sites binding names — not secrets. The owner provisions these in Sites Settings.
# HEALTHSPAN_SITES_D1_BINDING=DB
# HEALTHSPAN_SITES_R2_BINDING=FILES

# Absolute override for application data directory (SQLite + raw/)
# Windows example:
# HEALTHSPAN_DATA_DIR=C:\Users\you\AppData\Local\Healthspan Dashboard
# Developer relative override requires:
# HEALTHSPAN_ALLOW_RELATIVE_DATA_DIR=1
# HEALTHSPAN_DATA_DIR=.local-data

# Optional NCBI / Crossref courtesy identifiers
# NCBI_TOOL=healthspan_dashboard
# NCBI_EMAIL=you@example.com
# NCBI_API_KEY=
# CROSSREF_MAILTO=you@example.com

# Caps for first-run / smoke ingestion
HEALTHSPAN_FIRST_RUN_RECORD_CAP=50
HEALTHSPAN_LIVE_SMOKE_RECORD_CAP=5

# Jobs / scheduler (local)
# HEALTHSPAN_JOB_WORKER_ENABLED=true
# HEALTHSPAN_SCHEDULER_ENABLED=true
# HEALTHSPAN_ALLOW_REMOTE_ADMIN=false

# Optional openFDA (disabled unless enabled + key)
# HEALTHSPAN_OPENFDA_ENABLED=false
# OPENFDA_API_KEY=

# YouTube Data API (metadata only — never claim evidence)
# YOUTUBE_API_KEY=

# Optional X API (disabled by default; budget-capped; no auto-recharge; never sent to external AI)
# HEALTHSPAN_X_ENABLED=false
# HEALTHSPAN_X_BUDGET_ACKNOWLEDGED=false
# HEALTHSPAN_X_BUDGET_CAP_MICROS=0
# HEALTHSPAN_X_AUTO_RECHARGE_ALLOWED=false
# X_BEARER_TOKEN=
