{
  "name": "healthspan-dashboard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Healthspan Dashboard — longevity intelligence, evidence first.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @healthspan/api --filter @healthspan/web dev",
    "dev:web": "pnpm --filter @healthspan/web dev",
    "dev:api": "pnpm --filter @healthspan/api dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @healthspan/api build && pnpm --filter @healthspan/web build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @healthspan/web exec playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0"
  }
}
